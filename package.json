{
  "name": "stand-up-buddy",
  "version": "1.0.8",
  "description": "A whimsical retro pixel-art reminder that pops up every so often to tell you to stand up.",
  "main": "src/main.js",
  "author": "Stand Up Buddy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "generate-icon": "electron scripts/generate-icon.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.standupbuddy.app",
    "productName": "Stand Up Buddy",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "Stand-Up-Buddy-${os}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "ebioweiii",
      "repo": "stand-up-buddy"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
